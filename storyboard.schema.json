{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/stickman-storyboard.schema.json",
  "title": "Stickman video storyboard",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9_-]+$"
      },
      "title": {
        "type": "string"
      },
      "narration": {
        "type": "string"
      },
      "narration_segments": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "caption": {
              "type": "string"
            },
            "audio_file": {
              "type": "string"
            },
            "pause_after": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "caption": {
        "type": "string"
      },
      "background": {
        "type": "string"
      },
      "audio_file": {
        "type": "string"
      },
      "duration": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "min_duration": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "tail_pad": {
        "type": "number",
        "minimum": 0
      },
      "camera": {
        "enum": [
          "static",
          "zoom_in",
          "zoom_out",
          "pan_left",
          "pan_right"
        ]
      },
      "characters": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "rotation": {
              "type": "number"
            },
            "pose": {
              "enum": [
                "stand",
                "look_down",
                "point",
                "arms_up",
                "think",
                "walk"
              ]
            },
            "expression": {
              "enum": [
                "neutral",
                "smile",
                "confused",
                "surprised",
                "sad",
                "angry"
              ]
            },
            "shirt": {
              "type": "string"
            },
            "skin": {
              "type": "string"
            },
            "clothing": {
              "enum": [
                "shirt",
                "hide"
              ]
            },
            "style": {
              "type": "string",
              "enum": [
                "line",
                "hand"
              ]
            },
            "hair": {
              "type": "string",
              "enum": [
                "spikes",
                "bowl",
                "ring",
                "flat",
                "afro",
                "combover",
                "none"
              ]
            },
            "brow": {
              "type": "string",
              "enum": [
                "worried",
                "angry",
                "raised",
                "flat",
                "unibrow"
              ]
            },
            "nose": {
              "type": "string",
              "enum": [
                "hook",
                "potato",
                "pointy",
                "tiny"
              ]
            },
            "mouth": {
              "type": "string",
              "enum": [
                "flat",
                "grin",
                "squiggle",
                "open",
                "frown"
              ]
            },
            "outfit": {
              "type": "string",
              "enum": [
                "fur",
                "shirt",
                "tie",
                "overalls",
                "robe",
                "none"
              ]
            },
            "ears": {
              "type": "string",
              "enum": [
                "normal",
                "big",
                "none"
              ]
            },
            "hair_colour": {
              "type": "string"
            },
            "accent": {
              "type": "string"
            },
            "animation": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "preset": {
                      "enum": [
                        "none",
                        "walk_in",
                        "slide_in",
                        "pop_in"
                      ]
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration": {
                      "type": "number",
                      "minimum": 0
                    },
                    "from_x": {
                      "type": "number"
                    },
                    "walk_speed": {
                      "type": "number",
                      "minimum": 0
                    },
                    "walk_cycle": {
                      "type": "boolean"
                    },
                    "blink": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "props": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "arrow",
                "cross",
                "bubble",
                "node",
                "mirror",
                "arc",
                "star",
                "icon",
                "exchange"
              ]
            },
            "name": {
              "type": "string",
              "description": "icon 专用：sheep / rice / fish / shoes"
            },
            "animation": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "preset": {
                  "enum": [
                    "none",
                    "pop",
                    "grow"
                  ]
                },
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "duration": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "additionalProperties": true
        }
      },
      "paper_shape": {
        "enum": [
          "auto",
          "none",
          "circle_top_right",
          "circle_bottom_left",
          "band_bottom",
          "circle_top_left"
        ]
      },
      "background_style": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "paper_shape": {
                "enum": [
                  "auto",
                  "none",
                  "circle_top_right",
                  "circle_bottom_left",
                  "band_bottom",
                  "circle_top_left"
                ]
              },
              "ground": {
                "type": "boolean"
              },
              "title_stroke": {
                "type": "boolean"
              },
              "character_shadows": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "animation": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "blink": {
                "type": "boolean"
              },
              "blink_period": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "oversample": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "walk_cycle": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "connections": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "x1",
            "y1",
            "x2",
            "y2"
          ],
          "properties": {
            "x1": {
              "type": "number"
            },
            "y1": {
              "type": "number"
            },
            "x2": {
              "type": "number"
            },
            "y2": {
              "type": "number"
            },
            "color": {
              "type": "string"
            },
            "width": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  }
}
